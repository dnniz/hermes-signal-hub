#!/usr/bin/env python3
"""Run the signalhub CLI without installing it.

Adds ``src/`` to ``sys.path`` when the package is not already importable, so a
fresh checkout works with no install step and nothing beyond the standard
library. Resolves the GitHub token from the first readable well-known path
unless the caller already exported ``GH_TOKEN``.

The token is only ever read into the environment -- never passed as a
command-line argument, which would expose it in the process table.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

_SRC = Path(__file__).resolve().parent.parent / "src"
if _SRC.is_dir() and str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

# Ordered by precedence: explicit config first, then the conventional spots.
_TOKEN_PATHS = list(
    {
        Path.home() / ".config" / "signalhub" / "token",
        Path.home() / ".gh-token",
        Path("/opt/data/.gh-token"),
    }
)

if not os.environ.get("GH_TOKEN"):
    for _path in _TOKEN_PATHS:
        try:
            if _path.is_file():
                _token = _path.read_text(encoding="utf-8").strip()
                if _token:
                    os.environ["GH_TOKEN"] = _token
                    break
        except OSError:
            continue

from signalhub.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
